      <g class="np-village__snow">
        <polyline points="107,72 136,49 165,72"/>
        <polyline points="281,80 304,61 327,80"/>
        <polyline points="443,62 478,35 513,62"/>
        <polyline points="637,78 662,57 687,78"/>
        <polyline points="803,68 834,43 865,68"/>
        <polyline points="979,76 1006,55 1033,76"/>
        <polyline points="1151,66 1184,39 1217,66"/>
        <polyline points="1327,74 1352,53 1377,74"/>
