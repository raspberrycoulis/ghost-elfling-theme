        <rect x="462" y="70" width="8" height="9" rx="1"/>
        <rect x="486" y="70" width="8" height="9" rx="1"/>
        <rect x="658" y="86" width="8" height="9" rx="1"/>
        <rect x="818" y="76" width="8" height="9" rx="1"/>
        <rect x="842" y="76" width="8" height="9" rx="1"/>
        <rect x="1002" y="84" width="8" height="9" rx="1"/>
        <rect x="1168" y="74" width="8" height="9" rx="1"/>
        <rect x="1192" y="74" width="8" height="9" rx="1"/>
        <rect x="1348" y="82" width="8" height="9" rx="1"/>
      </g>
    </svg>
  {{/if}}
  <div class="m-footer__content">
    {{#if @site.secondary_navigation}}
      <nav class="m-footer__nav-secondary" role="navigation" aria-label="{{t "Secondary menu in footer"}}">
        {{navigation type="secondary"}}
      </nav>
    {{/if}}
    <p class="m-footer-copyright">
      <span>{{@site.title}} &copy; {{date format="YYYY"}}</span>
    </p>
  </div>
</footer>
