{{!--
This navigation template is shared across all the pages.
Also it includes the big submenu.
--}}

{{#if isSecondary}}
  <ul class="m-secondary-menu">
    {{#foreach navigation}}
      <li class="nav-{{slug}}{{#if current}} nav-current{{/if}}">
        <a href="{{url absolute="true"}}">{{label}}</a>
      </li>
    {{/foreach}}
  </ul>
{{else}}
  {{#foreach navigation}}
    <li class="nav-{{slug}}{{#if current}} nav-current{{/if}}">
      <a href="{{url absolute="true"}}" class="np-nav-link">{{> "icons/nav-icon" slug=slug}}<span>{{label}}</span></a>
    </li>
  {{/foreach}}
    <li class="np-nav-support">
      <a href="/#/portal/support" class="np-support-button" data-umami-event="header-support-us">
        {{> "icons/gift"}}
        <span>Support us</span>
      </a>
    </li>
{{/if}}
