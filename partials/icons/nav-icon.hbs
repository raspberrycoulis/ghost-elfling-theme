{{!--
Small line icons for the main navigation, chosen by the menu item's slug.
Slugs come from the labels in Settings > Navigation, e.g. "The Nice List" becomes "the-nice-list".
Any item without a match simply shows its label. Icons are decorative (aria-hidden).
--}}
{{#match slug "home"}}
  <svg class="np-nav-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 9.8V20h13V9.8"/><path d="M10 20v-5h4v5"/><path d="M15.5 6.6V4.5h2v3.8"/></svg>
{{else match slug "the-nice-list"}}
  <svg class="np-nav-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 3.5l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.8l-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z"/></svg>
{{else match slug "the-naughty-list"}}
  <svg class="np-nav-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M4.5 15.5 6.8 9 12 6l5.6 2.2 2.9 6.3-3.3 4H8z"/><path class="np-nav-icon__detail" d="M6.8 9l4.4 4.2 6.4-5M11.2 13.2l-1.2 5.3M11.2 13.2l6 1.3"/></svg>
{{else match slug "my-account"}}
  <svg class="np-nav-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M6 16.5C6.6 10.5 10 6 14.6 6c2.6 0 4.3 1.6 4.9 4"/><path d="M16.8 16.5c0-2.3.4-4.2 1.4-5.6"/><circle cx="19.6" cy="12" r="1.9"/><rect x="3.5" y="16.5" width="16" height="3.5" rx="1.75"/></svg>
{{else match slug "support-us"}}
  {{> "icons/gift"}}
{{/match}}
